# Local only: copy to .env; never commit .env
AWS_PROFILE=default
AWS_REGION=ap-south-1
AWS_KEY_NAME=my-existing-ec2-key
SSH_KEY_PATH=/home/you/.ssh/my-existing-ec2-key.pem
SSH_CIDR=203.0.113.10/32
EC2_TYPE=t3.medium
EC2_DISK_GB=30
# Used inside EC2 when running the container:
# LAB_ENV_FILE=/home/ubuntu/dotfiles/lab.env
