# Local only: copy to .env; never commit .env
AWS_PROFILE=default
AWS_REGION=ap-south-1
# AWS_KEY_NAME=my-ec2  # Optional override; default derived from SSH_KEY_PATH filename
SSH_KEY_PATH=~/my-ec2
SSH_CIDR=203.0.113.10/32
EC2_TYPE=t3.medium
EC2_DISK_GB=30
LAB_HOURS=4
# Used inside EC2 when running the container:
# LAB_ENV_FILE=/home/ubuntu/dotfiles/lab.env
