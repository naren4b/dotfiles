FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
  sudo git curl ca-certificates bash-completion vim unzip jq make python3 python3-pip \
  && rm -rf /var/lib/apt/lists/*
RUN useradd -m -u 1000 -s /bin/bash learner
COPY . /opt/dotfiles
RUN chown -R learner:learner /opt/dotfiles
USER learner
ENV HOME=/home/learner
RUN cd /opt/dotfiles && SETUP_PACKAGES=0 bash setup.sh
WORKDIR /workspace
CMD ["/bin/bash"]
